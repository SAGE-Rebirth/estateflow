# Copy to .env (repo root). The backend, worker and docker-compose all read this file.

# --- MongoDB (Atlas recommended: vector search + transactions) ---
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=estateflow
# Collection for RAG chunks + embeddings (an Atlas Vector Search index is created on it)
COLLECTION_NAME=chunks
# atlas = $vectorSearch; exact = brute force (local Mongo without Atlas Search)
VECTOR_SEARCH_MODE=atlas

# --- Auth (openssl rand -hex 32 for each) ---
SECRET_KEY=
REFRESH_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- App ---
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
REDIS_URL=redis://localhost:6379/0

# --- WhatsApp Cloud API. Webhook URL: {PUBLIC_BASE_URL}/api/v1/webhooks/whatsapp ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Hugging Face (chat, embeddings, speech-to-text, image description) ---
HUGGINGFACEHUB_API_TOKEN=
LLM_PROVIDER=huggingface
HF_PROVIDER=auto
HF_LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_PROVIDER=hf-inference
EMBEDDING_DIM=384
HF_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
HF_ASR_MODEL=openai/whisper-large-v3
TRANSCRIBE_VOICE_NOTES=true
DESCRIBE_IMAGES=true

# Optional: Claude for the chat model instead
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
