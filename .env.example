# Copy to .env (repo root). The backend, worker and docker-compose all read this file.

# --- MongoDB (Atlas recommended: vector search + transactions) ---
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=estateflow
# Collection for RAG chunks + embeddings (an Atlas Vector Search index is created on it)
COLLECTION_NAME=chunks
# atlas = $vectorSearch; exact = brute force (local Mongo without Atlas Search)
VECTOR_SEARCH_MODE=atlas

# --- Auth (openssl rand -hex 32 for each) ---
SECRET_KEY=
REFRESH_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- App ---
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
REDIS_URL=redis://localhost:6379/0

# --- WhatsApp Cloud API. Webhook URL: {PUBLIC_BASE_URL}/api/v1/webhooks/whatsapp ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Google Gemini (chat, embeddings, speech-to-text, image description) ---
GEMINI_API_KEY=
LLM_PROVIDER=gemini
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_MEDIA_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high — deeper thinking is slower and costs more
GEMINI_THINKING_LEVEL=low
# Changing the embedding model or size needs `make reindex` afterwards.
EMBEDDING_DIM=768
TRANSCRIBE_VOICE_NOTES=true
DESCRIBE_IMAGES=true

# Optional: Claude for the chat model instead
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
